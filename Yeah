def french_lesson():
    speak(
        "French lesson. "
        "Bonjour means hello. "
        "Merci means thank you. "
        "S'il vous plaît means please."
    )


def german_lesson():
    speak(
        "German lesson. "
        "Hallo means hello. "
        "Danke means thank you. "
        "Bitte means please."
    )


# =====================================================
# SCIENCE FACTS
# =====================================================

def science_fact():

    facts = [
        "A day on Venus is longer than its year.",
        "Jupiter is the largest planet in our solar system.",
        "Light from the Sun takes about eight minutes to reach Earth.",
        "Octopuses have three hearts.",
        "Saturn is less dense than water."
    ]

    speak(random.choice(facts))


# =====================================================
# INTERNET SEARCH
# =====================================================

def search_web(query):

    if not query:
        speak("What would you like me to search for?")
        return

    url = (
        "https://www.google.com/search?q="
        + urllib.parse.quote_plus(query)
    )

    speak("Opening your search.")
    webbrowser.open(url)


# =====================================================
# AI RESPONSE ENGINE
# =====================================================

def ai_response(command):

    command = command.lower().strip()

    if any(word in command for word in [
        "hello", "hi jarvis", "hey jarvis"
    ]):
        speak("Hello. JARVIS is online.")

    elif "time" in command:
        current_time = datetime.datetime.now().strftime(
            "%I:%M %p"
        )
        speak("The current time is " + current_time)

    elif "date" in command:
        current_date = datetime.datetime.now().strftime(
            "%A, %B %d, %Y"
        )
        speak("Today's date is " + current_date)

    elif "spanish" in command:
        spanish_lesson()

    elif "french" in command:
        french_lesson()

    elif "german" in command:
        german_lesson()

    elif "science fact" in command:
        science_fact()

    elif command.startswith("search for "):
        query = command.replace("search for ", "", 1)
        search_web(query)

    elif command.startswith("search "):
        query = command.replace("search ", "", 1)
        search_web(query)

    elif "who are you" in command:
        speak(
            "I am JARVIS, your personal assistant."
        )

    elif "how are you" in command:
        speak(
            "All systems are operating within normal parameters."
        )

    elif "help" in command:
        show_help()

    elif "stop listening" in command:
        disable_microphone()

    elif "exit jarvis" in command:
        shutdown()

    else:
        speak(
            "I heard your request, but I do not have "
            "a connected advanced AI service yet."
        )


