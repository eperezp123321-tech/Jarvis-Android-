import speech_recognition as sr
import pyttsx3
import datetime
import webbrowser
import urllib.parse
import random
import sys

# =====================================================
# SETTINGS
# =====================================================

APP_NAME = "JARVIS"

MICROPHONE_ENABLED = False
RUNNING = True

# =====================================================
# VOICE ENGINE
# =====================================================

speaker = pyttsx3.init()
speaker.setProperty("rate", 175)
speaker.setProperty("volume", 1.0)

recognizer = sr.Recognizer()
recognizer.pause_threshold = 0.8


def speak(message):
    print("\nJARVIS:", message)

    try:
        speaker.say(message)
        speaker.runAndWait()
    except Exception as error:
        print("Voice error:", error)


# =====================================================
# STARTUP
# =====================================================

def startup():
    print("=" * 45)
    print("          J.A.R.V.I.S.")
    print("    PERSONAL AI ASSISTANT")
    print("=" * 45)

    speak("JARVIS systems online.")
    speak("Microphone is currently disabled.")
    speak("Waiting for your instructions.")


# =====================================================
# MICROPHONE PERMISSIONS
# =====================================================

def enable_microphone():
    global MICROPHONE_ENABLED

    if MICROPHONE_ENABLED:
        speak("Microphone is already enabled.")
        return

    print("\nMICROPHONE ACCESS")
    print("JARVIS needs permission to hear your commands.")

    permission = input(
        "Do you approve microphone access? (yes/no): "
    ).lower().strip()

    if permission != "yes":
        speak("Microphone remains disabled.")
        return

    try:
        with sr.Microphone() as source:
            recognizer.adjust_for_ambient_noise(
                source, duration=1
            )

        MICROPHONE_ENABLED = True
        speak("Microphone session enabled.")

    except Exception as error:
        MICROPHONE_ENABLED = False
        speak("Microphone unavailable.")
        print(error)


def disable_microphone():
    global MICROPHONE_ENABLED

    MICROPHONE_ENABLED = False
    speak("Microphone disabled.")


# =====================================================
# VOICE RECOGNITION
# =====================================================

def listen_once():

    if not MICROPHONE_ENABLED:
        speak("Microphone access has not been enabled.")
        return ""

    try:
        with sr.Microphone() as source:

            print("\nListening...")
            audio = recognizer.listen(
                source,
                timeout=10,
                phrase_time_limit=10
            )

        command = recognizer.recognize_google(audio)

        print("\nYOU:", command)

        return command.lower()

    except sr.WaitTimeoutError:
        print("No speech detected.")

    except sr.UnknownValueError:
        speak("I didn't understand that.")

    except sr.RequestError:
        speak("Speech recognition service unavailable.")

    except Exception as error:
        print("Microphone error:", error)

    return ""


# =====================================================
# LANGUAGE LEARNING
# =====================================================

def spanish_lesson():
