# =====================================================
# CONTINUOUS LISTENING SESSION
# =====================================================

def continuous_listening():

    if not MICROPHONE_ENABLED:
        speak("Please enable the microphone first.")
        return

    speak("Continuous listening session started.")
    speak("Say stop listening to end this session.")

    while MICROPHONE_ENABLED and RUNNING:

        command = listen_once()

        if not command:
            continue

        if "stop listening" in command:
            disable_microphone()
            break

        if "exit jarvis" in command:
            shutdown()
            break

        ai_response(command)


# =====================================================
# TEXT COMMANDS
# =====================================================

def text_command():

    command = input("\nYOU: ").strip()

    if command.lower() == "exit":
        shutdown()
        return

    if command.lower() == "enable microphone":
        enable_microphone()
        return

    if command.lower() == "disable microphone":
        disable_microphone()
        return

    ai_response(command)


# =====================================================
# SHUTDOWN
# =====================================================

def shutdown():

    global RUNNING
    global MICROPHONE_ENABLED

    MICROPHONE_ENABLED = False
    RUNNING = False

    speak("JARVIS shutting down.")
    sys.exit(0)


# =====================================================
# MAIN PROGRAM
# =====================================================

def main():

    startup()

    while RUNNING:

        print("""
    =================================
               JARVIS
    =================================

    1. Enable microphone
    2. Start continuous listening
    3. Disable microphone
    4. Type a command
    5. Language lessons
    6. Science fact
    7. Help
    8. Exit

    =================================
        """)

        choice = input("Select an option: ").strip()

        if choice == "1":
            enable_microphone()

        elif choice == "2":
            continuous_listening()

        elif choice == "3":
            disable_microphone()

        elif choice == "4":
            text_command()

        elif choice == "5":
            print("""
            1. Spanish
            2. French
            3. German
            """)

            language = input("Choose language: ")

            if language == "1":
                spanish_lesson()
            elif language == "2":
                french_lesson()
            elif language == "3":
                german_lesson()

        elif choice == "6":
            science_fact()

        elif choice == "7":
            show_help()

        elif choice == "8":
            shutdown()

        else:
            print("Invalid selection.")


# =====================================================
# START JARVIS
# =====================================================

if __name__ == "__main__":
    try:
        main()

    except KeyboardInterrupt:
        shutdown()
